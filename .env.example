VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# UIDs of the two allowed accounts (set after they first sign in,
# or use custom claims — see README "Locking the app to two people")
VITE_PARTNER_1_EMAIL=ester@example.com
VITE_PARTNER_2_EMAIL=kypher@example.com

# Photo uploads need Firebase Storage, which requires the Blaze billing
# plan. Leave this false (or unset) until Storage is set up — the app
# hides upload buttons instead of erroring when this is off. Flip to
# true once you've enabled Storage in the Firebase console.
VITE_PHOTOS_ENABLED=false
